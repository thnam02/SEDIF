{
  "expo": {
    "name": "BVC bank",
    "slug": "sao-bank",
    "scheme": "saobank",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hainamtran.saobank",
      "appleTeamId": "Q5FR94THY5",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": { "package": "com.fides.saobank" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-build-properties", { "ios": { "deploymentTarget": "15.1" } }],
      "./plugins/withPodDeploymentTarget"
    ]
  }
}
